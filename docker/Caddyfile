{
  admin off
  persist_config off
  skip_install_trust
  auto_https disable_redirects
  default_sni {$POCKET_PUBLIC_HOST}
}
https://{$POCKET_PUBLIC_HOST}:8443 {
  tls internal
  @device path /device
  handle @device {
    reverse_proxy 127.0.0.1:8787
  }
  @health path /healthz
  handle @health {
    reverse_proxy 127.0.0.1:8787
  }
  @context_import path /context-import
  handle @context_import {
    reverse_proxy 127.0.0.1:8787
  }
  handle_path /setup/* {
    root * /srv/setup
    header Cache-Control "no-store"
    header X-Content-Type-Options "nosniff"
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    file_server
  }
  handle {
    respond 404
  }
}
