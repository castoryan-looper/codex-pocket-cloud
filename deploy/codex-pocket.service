[Unit]
Description=Codex Pocket Wi-Fi gateway and personal Codex executor
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=codex-pocket
Group=codex-pocket
WorkingDirectory=/var/lib/codex-pocket/workspace
EnvironmentFile=/etc/codex-pocket/pocket.env
ExecStart=/opt/codex-pocket/venv/bin/python /opt/codex-pocket/app/bridge/bridge.py --host 127.0.0.1 --http-port 8787
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-pocket

[Install]
WantedBy=multi-user.target
