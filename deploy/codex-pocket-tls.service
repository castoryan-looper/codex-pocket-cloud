[Unit]
Description=Codex Pocket HTTPS/WSS ingress
Wants=network-online.target
After=network-online.target codex-pocket.service

[Service]
Type=simple
User=codex-pocket-tls
Group=codex-pocket-tls
Environment=HOME=/var/lib/codex-pocket-tls
Environment=XDG_DATA_HOME=/var/lib/codex-pocket-tls/data
Environment=XDG_CONFIG_HOME=/var/lib/codex-pocket-tls/config
ExecStart=/opt/codex-pocket/tools/caddy/caddy run --config /etc/codex-pocket/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=10
UMask=0077
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/codex-pocket-tls

[Install]
WantedBy=multi-user.target
